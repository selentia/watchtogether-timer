{
  "manifest_version": 3,
  "name": "같이보기 타이머",
  "version": "0.1.0",
  "description": "화면 공유가 제한되는 환경에서 같이보기를 위한 재생 시간 표시·동기화 도구",

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },

  "action": {
    "default_title": "같이보기 타이머"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ],

  "permissions": ["tabs", "storage", "webNavigation", "scripting"]
}
